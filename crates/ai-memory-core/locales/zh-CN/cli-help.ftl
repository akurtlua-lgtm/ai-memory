cli-help-root-repair-split-workspace-help = { "工作区名称。 默认为最近的 `.ai-memory.toml` 标记的 `workspace`,否则为 `default`。" }
cli-help-root-repair-split-project-id-help = { "举行离职会话的项目(UUID)" }
