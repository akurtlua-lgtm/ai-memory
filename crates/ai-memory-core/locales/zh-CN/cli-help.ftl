cli-help-root-compact-long-about = { "重取免费数据库页面。删除任何内容。\u000A\u000A重建 FTS 索引和 VACUUMs , 将自由页返回到文件系统。`ai-memory status` 报告要回收多少内容——先检查一下:这需要一个独家锁，并重写整个数据库，所以每个写入块直到完成，并且需要数据库本身大小的自由磁盘空间。" }
cli-help-root-compact-confirm-help = { "REQUIRED。不是因为压缩会破坏任何东西，而是因为它会阻断每篇书写，直到它运行。" }
cli-help-root-reclaim-ledger-versions-about = { "删除 2.1.1 以前的索引程序遗留的旧事件日志版本" }
cli-help-root-reclaim-ledger-versions-long-about = { "删除 2.1.1 以前的索引程序遗留的旧事件日志版本。\u000A\u000A#660 修复了每次追加 Hook 事件都会重写整个 `log-YYYY-MM.md` 记录的问题。修复停止了新增旧版本，已写入的旧版本仍然存在。`compact` 只回收空闲页，`forget-sweep` 只彻底删除已标记为衰减清理的记录，而 `reindex` 会丢失仅存在于数据库中的数据。曾有一个存储中的 101 个当前页面累计保留了 6,539 个版本。\u000A\u000A此命令依据内容识别 Hook 事件日志。一个恰好名为 `log-2026-09.md` 的普通页面会保留完整版本链。被删除的每个版本都是下一版本的字节前缀，磁盘日志中已有的数据会保留。\u000A\u000A默认仅预览将删除的内容，指定 `--confirm` 后执行。`ai-memory status` 也会显示可回收空间。" }
cli-help-root-reclaim-ledger-versions-confirm-help = { "实际上删除。没有这个命令，命令会报告它会删除什么 —— 分类账路径、行数和字节数 —— 并且不会更改。" }
cli-help-root-reclaim-ledger-versions-drop-latest-help = { "也放下每个分类账的*活*行，不只是它被取代的版本" }
cli-help-root-reclaim-ledger-versions-drop-latest-long-help = { "同时删除每份事件日志的当前记录及旧版本。\u000A\u000A从 #660 起，索引程序会跳过事件日志，当前记录也是修复前的遗留数据。当前记录与磁盘文件对应，默认予以保留，是否删除由操作员决定。只有删除磁盘上的日志文件后才应删除该记录，否则下一次 Hook 追加事件会开始新的版本链。" }
cli-help-root-reclaim-ledger-versions-compact-help = { "随后重建 FTS 索引和 VACUUM, 将释放的字节返回文件系统" }
cli-help-root-reclaim-ledger-versions-compact-long-help = { "之后重建FTS索引和VACUUM,将释放的字节返回文件系统。\u000A\u000A没有这个回收是逻辑的删除——这些行已经消失，没有任何东西可以到达它们，但是它们的字节留在数据库文件的自由页面中，直到下次重写为止.`VACUUM`在独家锁下重写整个文件，并且需要大致是数据库自己大小的自由磁盘，所以它是选择进入的。" }
