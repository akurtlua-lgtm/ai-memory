cli-help-root-rename-project-workspace-help = { "工作区名称。 默认为最近的 `.ai-memory.toml` 标记的 `workspace`,否则为 `default`。" }
cli-help-root-rename-project-from-help = { "当前项目名称。 省略时，从最近的`.ai-memory.toml` 标记的`project` 中取出，然后从 git 远程，然后从当前目录的名称中取出。在将目录本身重命名后，通过`--from` :没有标记或远程的检查会解决新名称。" }
