cli-help-root-install-hooks-auth-token-help = { "安装在 hook 配置的`env` 块中的持卡符。 设定时，每个 hook call 都带有`Authorization: Bearer <token>`, 匹配服务器在设置AI_MEMORY_AUTH_TOKEN 时所需的内容。 生成一个 与`ai-memory generate-auth-token`" }
cli-help-root-install-hooks-as-user-help = { "用注册用户名标记已安装的 Hook，以显示操作员的能见度。此标记是元数据: 服务器通过`--auth-token` 解决通过API 键的归属。建议的工作流 :" }
cli-help-root-install-hooks-as-user-long-help = { "为已安装的 Hook 标注已注册的用户名，便于操作员识别。此标注仅用于显示，服务器根据 `--auth-token` 传递的 API 密钥确定归属。建议按以下步骤操作：\u000A\u000A# 1. 为用户发放 API 密钥（密钥只会显示一次）\u000Aai-memory api-key add --username alice --label claude-hooks\u000A\u000A# 2. 在智能体的 Hook 中配置该密钥\u000Aai-memory install-hooks --apply --agent claude-code --as-user alice --auth-token <alice-api-key>\u000A\u000A省略此参数时，安装程序会跳过用户名标注。服务器仍会在收到请求时根据 Bearer Token 确定归属。" }
cli-help-root-install-hooks-apply-help = { "直接修改所选智能体的 Hook 配置。默认仅显示配置片段或插件。重复运行会替换 ai-memory 条目或生成的插件。如果客户端支持配置合并，其他配置会保留。每次修改前都会在原文件旁写入带时间戳的备份" }
cli-help-root-install-hooks-config-file-help = { "覆盖选定智能体的设置/ 插件/ 扩展路径。对于 OpenClaw ,这是生成的插件包目录;对于 Cline CLI ,是 Hook 目录" }
cli-help-root-install-hooks-scope-help = { "在哪里写 Hook 配置。对于 Claude Code ,`project` 瞄准寄存器的`.claude/settings.local.json` (可用时在 git root 上) , 忽略`CLAUDE_CONFIG_DIR`。对于 Cline CLI , 在当前检查中它的目标为`.cline/hooks`。 无法与直接指定目标路径的`--config-file` 合并。" }
cli-help-root-install-hooks-project-strategy-help = { "将默认项目解析策略写入 Hook。`repo-root` 以 Git 主仓库根目录解析项目，将子目录和 worktree 归入同一项目，无需为每个仓库设置 `.ai-memory.toml`。标记文件内的 `project_strategy` 优先。`basename` 不写入策略，沿用原行为。不指定此参数时，重新运行 `--apply` 会保留此前 `--apply` 写入的策略，因此 `ai-memory upgrade` 等自动刷新操作不会把 `repo-root` 恢复为 `basename`" }
cli-help-root-install-hooks-capture-assistant-help = { "采集助手在本地 Stop Hook 中最终转折的静态摘录。在本地平台上支持了 Claude Code,Codex 和OpenCode 2; 服务器也必须设置`capture_assistant = true`。 赤裸的重新应用保留了已有的选入。 默认关闭" }
cli-help-root-install-hooks-capture-mode-help = { "坚持此安装的采集失败模式(# 446)。在`allowlist` 下，一个没有`.ai-memory.toml` 标记的寄存器会完全不显示每个智能体的生命周期事件。 存储在数据目录中，因此一个后期的赤色`--apply` —— 包括`upgrade` 内部的自动更新—— 无法重生它。 关闭此旗帜会让存储的模式不受影响;`--capture-mode denylist` 恢复默认" }
cli-help-root-install-hooks-no-capture-prompts-help = { "不要安装 Claude Code 的`UserPromptSubmit`采集钩。然后在进入本地 spool 或 线之前排除快速文本。 赤色`--apply` 重运行会保存现有的选择退出; 使用`--capture-prompts` 以再次明确启用快速采集" }
cli-help-root-install-hooks-capture-prompts-help = { "明确启用 Claude Code 快速采集在早先的`--no-capture-prompts` 安装后。只对 Claude Code 有效" }
