cli-help-root-rename-project-project-id-long-help = { "项目id(UUID)重命名，作为`--from`的替代品。\u000A\u000A当名称查询模糊不清时使用此功能: 遗留的行，其名称与另一个项目的相撞 `legacy_name` 因此只有身份证明才能找到它。 `list-projects` 输出。相互独占 `--from`." }
cli-help-root-rename-project-to-help = { "新建项目名称。 必须是非空的，并不含斜线" }
