cli-help-root-serve-base-path-help = { "整个 HTTP 表面在( 默认:从配置中) 下服务。 空( 配置默认) 将每个路由保留在主机根上。例如，设置 `/wiki` 在一个保存前缀的反向代理后面的 URL 子路径下主机 ai-memory ;然后, `/mcp`, `/api/v1`, `/hook` 和网络 UI 都生活在它下面 (`/wiki/mcp`, `/wiki/api/v1`,...)。 值是正常化的 `/<core>` (引导斜线，没有跟踪); `/` 和\\ b两个均是正根。" }
cli-help-root-serve-web-slug-help = { "粘贴 web UI 挂载在, Within `--base-path`. 默认 `/web` (只读 `/api/v1`API 总是留在 `<base>/api/v1` )。 设置 `/` 以服务 UI 本身于基根(如 `/wiki` 而不是 `/wiki/web` )。 服务器将一个正常的 `<base href>` 注入到已服务的 HTML 中，因此内置的 UI 和自定义 `--web-ui-dir` SPA 都可以在前缀下解决资产而无需重建。" }
cli-help-root-serve-http-stateful-help = { "以状态(会话)模式运行 HTTP 传输: 服务器在 `initialize` 上发布一个 `Mcp-Session-Id` , 并在以后的每次请求中要求它，并有 SSE 框架的响应。 默认情况下 —— HTTP 运输是无国籍的，并返回简单 JSON,因此无国籍客户端 (OpenCode`type: \"remote\"`, `curl`) 工作没有 `mcp-remote`stdio shim (issue# 3)。 仅对需要会话连续性或服务器启动的 SSE 流的客户端启用此功能。对 `--transport stdio` 没有任何影响。" }
cli-help-root-serve-cors-allow-origin-help = { "允许调用/api/v1 跨源( CORS)。 重复多个源的旗帜，或者将AI_MEMORY_CORS_ALLOW_ORIGINS 设置为逗号分隔的列表。 必须是完全合格的源(如https://app.example.com ); 拒绝使用`*` ( CORS spec 禁止证书 + 通配符)。 空 = 仅同源" }
