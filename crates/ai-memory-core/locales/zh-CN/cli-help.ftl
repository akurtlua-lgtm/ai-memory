cli-help-root-finalize-session-reopen-help = { "重新完成已经结束的会话( 需要`--session-id` )" }
cli-help-root-finalize-session-reopen-long-help = { "重新完成已经结束的会话(需要`--session-id`)。\u000A\u000A当第一次定稿后对话继续进行并登陆新的观察时使用此功能:没有真实会话尾端事件( Antigravity CLI, Kiro, ZCode, Pool) 的智能体员会在同一会话ID下持续采集，但简单的发现步骤只看到公开会话，所以第二次定稿会默默无闻地找到任何内容。 使用`--reopen` 检索也会匹配结束会话和正常会话尾路径的重运行( 更新摘要页，交接，选入合并 )。在第一个会话结束后没有任何新的会话登陆时，重运行是无害的禁用。" }
cli-help-root-finalize-session-json-help = { "发送一个JSON摘要" }
cli-help-root-recover-about = { "恢复服务器中断期间遗漏的历史。发送本地待处理的 Hook 事件，重新导入降级运行的会话记录，并结束导入失败的托管运行。可以安全地重复运行" }
cli-help-root-recover-json-help = { "将机器可读报告打印为JSON在stdout上" }
cli-help-root-pending-writes-about = { "查看、批准或拒绝待审核的自动改进提案" }
cli-help-root-embed-about = { "为每个最新页面生成并存储嵌入向量（M9）" }
cli-help-root-embed-dry-run-help = { "报告将嵌入哪些东西而不发生实际变异" }
cli-help-root-embed-force-help = { "重新嵌入的页面，即使它们已经与当前配置的排行`(provider, model, dim)`" }
cli-help-root-embed-workspace-help = { "工作区名称( 缺席时自动创建)" }
cli-help-root-embed-project-help = { "项目名称。 省略时，取自最近的`.ai-memory.toml` 标记的`project`,然后取自 git 远程，然后取自当前目录的名称。 匹配钩路由器的每个 cwd 常规，因此此命令目标为相同的项目会话。" }
cli-help-root-generate-auth-token-about = { "生成供 AI_MEMORY_AUTH_TOKEN 使用的随机十六进制 Bearer Token" }
cli-help-root-generate-auth-token-bytes-help = { "任意字节的Entropy数。 打印的符号是六进制编码的，因此输出长度是 2x此值。 32 字节( 256 位) 对任何家居实验室威胁模型来说都是足够的。" }
cli-help-root-setup-agent-about = { "为 Docker 部署一次性配置智能体。将内置 Hook 提取到主机挂载的目录，并输出对应的配置片段。无需在本机克隆仓库或安装 Rust 工具链" }
cli-help-root-setup-agent-agent-help = { "提取 + 渲染 的哪个智能体的钩捆" }
cli-help-root-setup-agent-opencode-dialect-help = { "在使用`--agent opencode` 时使用OpenCode 文物方言。 需要这样做是因为设置智能体通常运行在一个不能检查主机可执行文件的容器中。`opencode2` 的别名强制使用 V2 并拒绝此旗帜。" }
cli-help-root-setup-agent-to-help = { "指定接收 Hook 脚本的目录。使用 Docker 时，此路径位于容器内，请将主机目录挂载到该位置。例如：`docker run --rm -v $HOME/.ai-memory:/host ai-memory setup-agent --to /host/hooks ...`" }
cli-help-root-setup-agent-host-prefix-help = { "生成的 JSON 配置用此目录定位 Hook 命令，默认为 `--to`。如果运行智能体 CLI 的主机路径和容器路径不同，可设置此选项，例如 `--to /host/hooks --host-prefix $HOME/.ai-memory/hooks`" }
cli-help-root-setup-agent-server-url-help = { "MCP / 勾引入侵URL 智能体机应当使用 POST。 设置时默认为配置的`server_url` /AI_MEMORY_SERVER_URL,否则回转" }
cli-help-root-setup-agent-auth-token-help = { "写入每个 Hook 的 env 配置块的 Bearer Token。省略时使用从配置解析的 Token" }
cli-help-root-setup-agent-source-help = { "嵌入式 Hook 捆绑的源目录。 默认为`/usr/local/share/ai-memory/hooks` (嵌入式图像的捆绑路径) , 并在开发过程中返回到 repo- local`hooks/` for`cargo run setup-agent`" }
cli-help-root-bootstrap-about = { "通过 LLM 汇总 Git 日志、README、docs/ 和模块说明，将现有项目的历史写入初始 Wiki 页面。为已有项目接入 ai-memory 时运行一次。服务端需设置 AI_MEMORY_LLM_PROVIDER" }
cli-help-root-bootstrap-repo-path-help = { "用于收集历史( 服务器从未看到此路径) 的客户端路径。 默认为`git rev-parse --show-toplevel`从当前目录中解析(因此从项目项目的任何子目录中运行 pootrap)。" }
cli-help-root-bootstrap-workspace-help = { "工作区名称。 默认到最近的`.ai-memory.toml` 标记的`workspace`, 其它的`default` —— 使用寿命周期 Hook 的同一分辨率，因此 拖曳页会话采集到的地方" }
cli-help-root-bootstrap-project-help = { "项目名称。 省略时，从最近的`.ai-memory.toml` 标记的`project` 中取出，然后从 git 远程中取出，然后从当前目录的名称(不是`--repo-path`) 中取出，钩路由器使用的分辨率相同，因此 拖曳页会与未来会话采集的相同项目。" }
cli-help-root-bootstrap-project-long-help = { "项目名称。 省略时，从最近的`.ai-memory.toml` 标记的`project` 中取出，然后从 git 远程，然后从当前目录的名称中取出(不是`--repo-path` ), 勾钩路由器使用的分辨率，因此，拖曳页与未来会话采集的相同项目。\u000A\u000A点前缀的 dirs 被逐字保存——`~/.config`成为项目`.config`,匹配路由器对从那里启动的会话所做的。 Pass`--project` 明确要覆盖。" }
cli-help-root-bootstrap-max-input-tokens-help = { "一次发送到LLM 的源文本最大总符号。当收集的源超过此值时，优先级较低的输入( older git confession,然后是代码模块头，然后是docs) 会被先丢弃。 默认值为 150K,所以模型会尽可能多地看到您的项目; 将( 默认值) ,每个调用符最多带在`--chunk-input-tokens` 上加到 16K 输出符。如果您对成本敏感，请降低它。 使用`--chunk-input-tokens 0` , 整个预算会进入一个调用，也要求最多64K 输出符，因此预算 + 64K 必须与模型上下文窗口相匹配( 150K 默认值不符合 200K 窗口)" }
cli-help-root-bootstrap-chunk-input-tokens-help = { "最大估计每个LLM 调用输入符。当被调用源超过此值时，拖曳符会运行多个顺序的LLM 块，而不是一个巨大的提示( 避免提供商上下文限制 / 光标桥失败 )。 设置为`0` 以禁用切换( 单调用全调用捆绑)" }
cli-help-root-bootstrap-exclude-git-help = { "跳过导入 Git 提交历史" }
cli-help-root-bootstrap-exclude-readme-help = { "跳过README摄入" }
cli-help-root-bootstrap-exclude-docs-help = { "跳过 Docs/**/*.md 摄入" }
cli-help-root-bootstrap-exclude-code-help = { "跳过代码模块头( Rust`//!` doc- comments 位于`**/*.rs`文件顶端)" }
cli-help-root-bootstrap-since-help = { "git-log 时间过滤器( 被通过到`git log --since` )。当一个 repo 已经过期，您只想要最近的历史(如`--since \"180 days ago\"` ) 时有用。 默认:无限制。" }
cli-help-root-bootstrap-dry-run-help = { "LLM调用干线: 收集源，建立快捷键，并打印将发送的** ,但从不给提供者打电话，也从不写给Wiki。在支付真实运行费用之前，用于验证源选择。" }
cli-help-root-bootstrap-force-help = { "重新设置一个已有一个靴子标签列表页的项目。如果没有此旗帜,`bootstrap` 拒绝在同一列表中运行两次( 列表为`wiki/bootstrap.md`)。" }
cli-help-root-bootstrap-resume-help = { "恢复中断的靴子:重新使用已经为同一来源完成的块，而不是重新运行它们" }
cli-help-root-install-instructions-about = { "将 ai-memory 的使用指引和受管智能体技能安装到项目中，也可指定 Markdown 文件或技能目录。重复运行会替换 `<!-- ai-memory:start -->` 与 `<!-- ai-memory:end -->` 之间的区块" }
cli-help-root-install-instructions-target-help = { "目标 Markdown 文件。省略时，写入 $PWD 现有的 `CLAUDE.md` 或 `AGENTS.md`。两个都存在时同时更新，两个都不存在时按 Claude Code 的约定创建 `CLAUDE.md`，并提示 Codex、OpenCode、Cursor 或 Gemini 用户可以指定 `--target AGENTS.md`。显式传入 `--target` 可跳过自动检测" }
cli-help-root-install-instructions-print-help = { "打印片段到stdout 而不是突变文件。 默认的 IS 突变在此(没有此命令也可以使用打印表单——从README 复制块)。 pass`--print` 以预览文件中会降落的内容。这不会打印技能有效载荷; 使用`install-skills --print` 来预览管理的智能体技能。" }
cli-help-root-install-instructions-no-skills-help = { "跳过安装/更新管理中的ai-memory智能体技能" }
cli-help-root-install-instructions-compact-help = { "写一个紧凑的路由片段，由代表安装智能体技能，而不是排入完整的操作指导" }
cli-help-root-install-instructions-skills-scope-help = { "管理下的ai-memory技能安装范围" }
cli-help-root-install-instructions-skills-agent-help = { "用于管理中的ai-memory技能安装的智能体技能目录家族" }
cli-help-root-install-instructions-skills-target-dir-help = { "覆盖管理技能根目录" }
cli-help-root-install-instructions-skills-force-help = { "从`install-instructions` 安装时覆盖同名的未管理技能" }
cli-help-root-install-skills-about = { "将 ai-memory 管理的核心技能安装到各智能体的技能目录" }
cli-help-root-install-skills-scope-help = { "安装项目当地技能或全球用户技能" }
cli-help-root-install-skills-agent-help = { "要安装到哪个智能体技能目录家族" }
cli-help-root-install-skills-target-dir-help = { "覆盖技能根目录。当设定时,`--scope` 和`--agent` 会被忽略，管理下的技能目录会被写入此根下面" }
cli-help-root-install-skills-print-help = { "不写入文件而打印目标路径和SKILL.md内容" }
cli-help-root-install-skills-force-help = { "覆盖未包含 ai-memory 管理标记的同名现有技能。如果没有此标记，将保留未管理的技能，命令退出时会出现可操作错误" }
cli-help-root-reorg-about = { "根据会话开始时记录的当前工作目录，将现有会话和观测记录归入各自项目。旧页面会标为 `is_latest=false`，以便下次归整按项目重新生成页面。可以安全地重复运行" }
cli-help-root-reorg-dry-run-help = { "显示不写会改变什么" }
cli-help-root-purge-project-about = { "删除项目及其页面、会话、观测记录、交接记录、嵌入向量、托管 Workstream 和磁盘上的 Wiki 文件" }
cli-help-root-purge-project-long-about = { "删除项目及其页面、会话、观测记录、交接记录、嵌入向量、托管 Workstream 和磁盘上的 Wiki 文件。\u000A\u000A操作不可撤销，必须指定 `--confirm`。默认执行逻辑删除，记录无法通过 API 或搜索访问，但其字节仍保留在 SQLite 数据库的空闲页中，直至重写数据库。`--compact` 可回收这些空间。Wiki 的 Git 历史和删除前的备份仍可能保留内容，以上两种方式均无法保证取证级擦除。" }
cli-help-root-purge-project-force-help = { "即使此项目中的托管 Workstream 仍持有有效运行租约，也执行清除。删除项目记录会级联删除 Workstream，默认会拒绝删除仍在运行的会话租约" }
cli-help-root-purge-project-workspace-help = { "工作区名称。 默认为最近的 `.ai-memory.toml` 标记的 `workspace`,否则为 `default`。" }
cli-help-root-purge-project-project-help = { "项目名称。 省略时，从最近的 `.ai-memory.toml` 标记的 `project` 中取出，然后从 git 远程，然后从当前目录的名称中取出" }
cli-help-root-purge-project-project-id-help = { "项目 id (UUID) 进行清洗，作为`--project` 的替代品" }
cli-help-root-purge-project-project-id-long-help = { "项目id(UUID)进行清洗，作为`--project`的替代品。\u000A\u000A当名称查询模糊不清时使用此功能: 遗留的行，其名称与另一个项目的相撞 `legacy_name` 因此只有身份证明才能找到它。 `list-projects` 输出。相互独占 `--project`." }
cli-help-root-purge-project-confirm-help = { "清除操作必须指定此选项。省略时 CLI 会报错，因为清除不可撤销" }
cli-help-root-purge-project-confirm-long-help = { "清除操作必须指定此选项。省略时 CLI 会报错，因为清除不可撤销。\u000A\u000A报错前，CLI 会请求服务端生成预览，包括身份验证刷新的耗时，整个请求最多等待数秒。预览使用正式清除相同的查询，列出页面、会话、观测记录、交接记录、嵌入向量、Workstream、托管运行，以及可能在其他项目中被删除或失去归属的记录。预览只影响输出。服务端返回 404/409/403 或其他异常状态时，会先显示服务端错误。遇到超时、无法连接或服务端版本过旧时，会照常拒绝清除。" }
cli-help-root-purge-project-compact-help = { "删除提交后重建 FTS 索引并执行 VACUUM，回收空闲磁盘空间" }
cli-help-root-purge-project-compact-long-help = { "删除提交后重建 FTS 索引并执行 VACUUM，回收空闲磁盘空间。\u000A\u000A默认执行逻辑删除。项目无法通过 API 或搜索访问，但字节仍保留在 SQLite 数据库的空闲页中，直到数据库被重写。\u000A\u000A该操作重写整个数据库，需要约等于数据库大小的可用磁盘空间。大型数据库可能需要数分钟。Wiki 的 Git 历史和删除前的备份仍包含原文，因此无法保证取证级擦除。" }
cli-help-root-purge-session-about = { "永久删除一个会话及其派生数据" }
cli-help-root-purge-session-long-about = { "永久删除一个会话及其派生数据。\u000A\u000A仅在指定的工作区和项目中，删除会话记录、观测记录、该会话创建的交接、派生 Wiki 页面及其所有版本，以及相应的嵌入向量。该会话仅领取的交接仍会保留，其正文归创建该交接的会话所有。" }
cli-help-root-purge-session-session-id-help = { "完整的会话 UUID，必须与 `sessions.id` 一致" }
cli-help-root-purge-session-workspace-help = { "工作区名称。 默认为最近的 `.ai-memory.toml` 标记的 `workspace`,否则为 `default`。" }
cli-help-root-purge-session-project-help = { "项目名称。 省略时，从最近的 `.ai-memory.toml` 标记的 `project` 中取出，然后从 git 远程，然后从当前目录的名称中取出" }
cli-help-root-purge-session-confirm-help = { "清除操作必须指定此选项。省略时 CLI 会报错，因为清除不可撤销" }
cli-help-root-purge-session-confirm-long-help = { "清除操作必须指定此选项。省略时 CLI 会报错，因为清除不可撤销。\u000A\u000A报错前，CLI 会请求服务端生成预览，包括身份验证刷新的耗时，整个请求最多等待数秒。预览使用正式清除相同的查询，列出观测记录、交接记录、页面、自动改进运行，以及可能在其他项目中被删除或失去归属的记录。预览只影响输出。服务端返回 404/403 或其他异常状态时，会先显示服务端错误。遇到超时、无法连接或服务端版本过旧时，会照常拒绝清除。" }
cli-help-root-purge-session-compact-help = { "还恢复释放的字节:重建受影响的FTS索引，在删除后重建数据库。" }
cli-help-root-purge-session-compact-long-help = { "删除提交后重建受影响的 FTS 索引并执行 VACUUM，回收空闲磁盘空间。\u000A\u000A默认执行逻辑删除。会话无法通过 API 或搜索访问，但字节仍保留在 SQLite 数据库的空闲页中，直到数据库被重写。\u000A\u000A该操作重写整个数据库，需要约等于数据库大小的可用磁盘空间。大型数据库可能需要数分钟。Wiki 的 Git 历史和删除前的备份仍包含原文，因此无法保证取证级擦除。" }
